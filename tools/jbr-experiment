#!/bin/bash
# jbr-experiment [seconds] [WxH]
# Runs the FramePacing harness unpaced vs paced at a given window size.
# Window size is the sweep variable (display mode held constant), matching the
# Windows methodology so the two platforms are directly comparable.
if [ "${1:-}" = "--calibrate" ]; then
  # Records what THIS machine draws when quiet, so the guard has a real
  # reference instead of a number borrowed from different silicon.
  echo "Measuring idle package power. Leave the machine alone for ~30s."
  jbr-measure "warmup" 3 >/dev/null 2>&1
  best=""
  for i in 1 2 3; do
    w=$(jbr-measure "calib$i" 8 | grep -oE 'pkg=[[:space:]]*[0-9.]+' | grep -oE '[0-9.]+$')
    echo "  sample $i: ${w:-?} W"
    best=$(awk -v a="${best:-999}" -v b="${w:-999}" 'BEGIN{print (b+0<a+0)?b:a}')
  done
  echo "$best" | sudo tee /etc/jbr-idle-baseline >/dev/null
  echo "baseline = $best W  ->  guard will trip above $(awk -v b="$best" 'BEGIN{printf "%.2f", b*1.6+0.5}') W"
  exit 0
fi

SECS="${1:-20}"
WIN="${2:-1600x1000}"
# The compositor's socket and Mutter's Xwayland cookie both live in the session
# owner's /run/user/<uid>, which is mode 0700 -- invisible even to another
# account with passwordless sudo. So the session cannot be found by scanning
# that directory; ask logind, whose session list any user may read.
GUI_UID=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4=="seat0"{print $2; exit}')
GUI_USER=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4=="seat0"{print $3; exit}')
if [ -z "$GUI_UID" ]; then
  echo "No graphical session on seat0. Log in at the console first --"
  echo "  pacing measurements need a live compositor, not just a running machine."
  exit 1
fi

# Run as the session owner. The harness is a GUI client and has to be the account
# whose compositor it renders into. -H so $HOME follows too, otherwise the build
# lookups below would still resolve against the invoking account's home.
if [ "$(id -u)" != "$GUI_UID" ]; then
  SELF=$(readlink -f "$0")
  exec sudo -H -u "$GUI_USER" -- "$SELF" "$@"
fi

export XDG_RUNTIME_DIR="/run/user/$GUI_UID"
export WAYLAND_DISPLAY=wayland-0
export DISPLAY=:0
# Mutter randomises this cookie name per session, so it has to be globbed.
export XAUTHORITY=$(ls -t "$XDG_RUNTIME_DIR"/.mutter-Xwaylandauth.* 2>/dev/null | head -1)

# Must be the real image, not support/jrtfs_classes/jdk -- require a runnable java.
JBR=""
for d in $(find "$HOME/src/JetBrainsRuntime/build" -maxdepth 4 -type d -name jdk 2>/dev/null); do
  [ -x "$d/bin/java" ] && JBR="$d" && break
done
[ -n "$JBR" ] || { echo "No JBR build found"; exit 1; }
BIN="$HOME/src/frame-pacing-test/build/install/frame-pacing-test/bin/frame-pacing-test"
[ -x "$BIN" ] || { echo "Harness not built"; exit 1; }

CONNECTED=""
for s in /sys/class/drm/card*-*/status; do
  [ -e "$s" ] || continue
  [ "$(cat "$s")" = connected ] && CONNECTED="$(basename "$(dirname "$s")")"
done
[ -n "$CONNECTED" ] || { echo "NO DISPLAY ATTACHED -- pacing measurements need an active CRTC"; exit 1; }

# --- idle guard -------------------------------------------------------------
# Background load corrupts the power figures (CPU contention shows up in pkg/core
# while GT stays sane, which is confusing to spot after the fact).
#
# The threshold cannot be a constant. A quiet i5-9500T idles near 0.5 W package;
# a 16-thread Ryzen does not, and a fixed 2 W ceiling would refuse to run on a
# perfectly idle machine. So the ceiling is calibrated per host:
#   JBR_IDLE_MAX=<watts>       explicit override, wins over everything
#   /etc/jbr-idle-baseline     written by `jbr-experiment --calibrate`
#   otherwise                  2.0 W, which suits the small Intel parts only
BASELINE_FILE=/etc/jbr-idle-baseline
if [ -n "${JBR_IDLE_MAX:-}" ]; then
  IDLE_MAX="$JBR_IDLE_MAX"
elif [ -r "$BASELINE_FILE" ]; then
  IDLE_MAX=$(awk '{printf "%.2f", $1 * 1.6 + 0.5}' "$BASELINE_FILE")
else
  IDLE_MAX=2.0
fi
# The FIRST measurement in a fresh ssh session reads ~4 W regardless of load:
# it captures session startup (ssh login, bash init, first sudo doing PAM +
# sudoers parse). Discard one sample so the guard measures the machine, not us.
jbr-measure "warmup" 3 >/dev/null 2>&1
PRE=$(jbr-measure "preflight" 5)
IDLE_W=$(echo "$PRE" | grep -oE 'pkg=[[:space:]]*[0-9.]+' | grep -oE '[0-9.]+$')
# 0.00 W is not a quiet machine, it is a failed read: rd() falls back to 0 when
# the RAPL counters cannot be opened. Treating that as "idle" would wave through
# a run whose power columns are all zero, so refuse it explicitly.
if [ -z "${IDLE_W:-}" ] || awk -v w="${IDLE_W:-0}" 'BEGIN{exit !(w+0 <= 0)}'; then
  echo "ABORT: package power read back as ${IDLE_W:-empty} W -- the RAPL counters"
  echo "  are not readable by $(whoami). They are root-only by design; grant this"
  echo "  account /usr/local/bin/jbr-rapl in sudoers, or run jbr-measure to see"
  echo "  which columns come back zero."
  exit 1
fi
if awk -v w="${IDLE_W:-99}" -v m="$IDLE_MAX" 'BEGIN{exit !(w+0 > m+0)}'; then
  echo "ABORT: machine is not idle -- package power ${IDLE_W} W (ceiling ${IDLE_MAX} W)."
  echo "  if this machine is genuinely quiet, run: jbr-experiment --calibrate"
  echo "  measurements would be corrupted by CPU contention. Top consumers:"
  ps -eo pcpu,pid,args --sort=-pcpu | head -6 | cut -c1-110 | sed 's/^/    /'
  exit 1
fi
echo "  idle check: ${IDLE_W} W package (ceiling ${IDLE_MAX} W) -- quiet, proceeding"

# i915_display_info is Intel-only. Ask Mutter first (it knows the active mode
# including refresh), then fall back to the connector's preferred mode, which is
# the first line of its modes file.
MODE=$(gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
         --object-path /org/gnome/Mutter/DisplayConfig \
         --method org.gnome.Mutter.DisplayConfig.GetCurrentState 2>/dev/null \
       | grep -oE "'[0-9]+x[0-9]+@[0-9.]+'" | head -1 | tr -d "'")
[ -n "$MODE" ] || MODE=$(head -1 "/sys/class/drm/$CONNECTED/modes" 2>/dev/null)
[ -n "$MODE" ] || MODE="(mode unknown)"
echo "=== FramePacing: unpaced vs paced ==="
echo "  host:    $(hostname)   window: $WIN"
echo "  output:  $CONNECTED   $MODE"
echo

run_mode() {   # $1 = on|off  $2 = label
  local log=/tmp/fp-$1.log
  JAVA_HOME="$JBR" FRAME_PACING_TEST_OPTS="-Dpacing=$1 -Dwindow=$WIN" "$BIN" > "$log" 2>&1 &
  local P=$!
  sleep 10
  if ! kill -0 "$P" 2>/dev/null; then
    echo "  $2: app exited early --"; head -6 "$log" | sed 's/^/      /'; return 1
  fi
  jbr-measure "$2 win=$WIN" "$SECS"
  awk -F': *' '/renders\/sec/{v[++n]=$2}
       END{s=0;c=0; for(i=4;i<=n;i++){s+=v[i];c++}
           if(c) printf "  %-30s renders/sec avg = %.1f  (n=%d)\n","",s/c,c}' "$log"
  kill "$P" 2>/dev/null; pkill -f MainKt 2>/dev/null; sleep 2; pkill -9 -f MainKt 2>/dev/null; sleep 6
}

run_mode off "UNPACED"
echo
run_mode on  "PACED  "
echo
# --- post-run idle check ---------------------------------------------------
# The start-of-run guard cannot catch load that appears mid-run (e.g. a Gradle
# daemon waking up), which silently inflates pkg/core while leaving GT looking
# sane. Re-check afterwards and say so loudly if the run is suspect.
POST=$(jbr-measure "postflight" 5)
POST_W=$(echo "$POST" | grep -oE 'pkg=[[:space:]]*[0-9.]+' | grep -oE '[0-9.]+$')
if awk -v w="${POST_W:-99}" -v m="$IDLE_MAX" 'BEGIN{exit !(w+0 > m+0)}'; then
  echo "  *** SUSPECT RUN: package power was ${POST_W} W after the run (ceiling ${IDLE_MAX} W)."
  echo "  *** Something loaded the machine mid-run; power figures above are unreliable."
  ps -eo pcpu,pid,args --sort=-pcpu | head -5 | cut -c1-110 | sed 's/^/      /'
else
  echo "  idle after run: ${POST_W} W -- clean, figures are trustworthy"
fi
echo
grep -ihE 'framepacing' /tmp/fp-on.log | head -2 | sed 's/^/  /'
