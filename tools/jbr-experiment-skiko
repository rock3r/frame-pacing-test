#!/bin/bash
# jbr-experiment-skiko [seconds] [WxH]
# Skiko-direct variant of jbr-experiment: same guards and measurement, but drives
# SkikoDirectMainKt with the mavenLocal skiko 0.0.0-SNAPSHOT jars prepended, so the
# pacing under test is the one inside skiko (skiko.swing.frame.pacing), not the
# app-level RepaintManager pacer. Launches the installDist lib dir directly -- no
# Gradle at run time, which would trip the idle guard.
SECS="${1:-20}"
WIN="${2:-1600x1000}"
# Optional third argument: which screen to launch on. The pacer binds its display
# once at construction, so a mixed-refresh setup is measured by launching on each
# display in turn.
DISPLAY_IDX="${3:-}"
# The compositor's socket and Mutter's Xwayland cookie both live in the session
# owner's /run/user/<uid>, which is mode 0700 -- invisible even to another
# account with passwordless sudo. So the session cannot be found by scanning
# that directory; ask logind, whose session list any user may read.
GUI_UID=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4=="seat0"{print $2; exit}')
GUI_USER=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$4=="seat0"{print $3; exit}')
if [ -z "$GUI_UID" ]; then
  echo "No graphical session on seat0. Log in at the console first --"
  echo "  pacing measurements need a live compositor, not just a running machine."
  exit 1
fi

# Run as the session owner. The harness is a GUI client and has to be the account
# whose compositor it renders into. -H so $HOME follows too, otherwise the build
# and jar lookups below would still resolve against the invoking account's home.
if [ "$(id -u)" != "$GUI_UID" ]; then
  SELF=$(readlink -f "$0")
  # sudo resets the environment, so anything the run depends on must be passed
  # through explicitly -- otherwise JBR_TOOLKIT is silently lost and the run
  # quietly falls back to XWayland while claiming to test Wayland.
  exec sudo -H -u "$GUI_USER" env JBR_TOOLKIT="${JBR_TOOLKIT:-}" JBR_IDLE_MAX="${JBR_IDLE_MAX:-}" "$SELF" "$@"
fi

export XDG_RUNTIME_DIR="/run/user/$GUI_UID"
export WAYLAND_DISPLAY=wayland-0

# JBR_TOOLKIT=WLToolkit runs against the native Wayland toolkit instead of
# XWayland. It is not cosmetic: an XWayland surface does not get Mutter's
# direct-scanout path, so VRR never arms for it, and every frame carries an
# extra translation layer.
TOOLKIT_OPT=""
if [ "${JBR_TOOLKIT:-}" = "WLToolkit" ]; then
  TOOLKIT_OPT="-Dawt.toolkit.name=WLToolkit"
  unset DISPLAY XAUTHORITY
else
  export DISPLAY=:0
  # Mutter randomises this cookie name per session, so it has to be globbed.
  export XAUTHORITY=$(ls -t "$XDG_RUNTIME_DIR"/.mutter-Xwaylandauth.* 2>/dev/null | head -1)
fi

# Must be the real image, not support/jrtfs_classes/jdk -- require a runnable java.
JBR=""
for d in $(find "$HOME/src/JetBrainsRuntime/build" -maxdepth 4 -type d -name jdk 2>/dev/null); do
  [ -x "$d/bin/java" ] && JBR="$d" && break
done
[ -n "$JBR" ] || { echo "No JBR build found"; exit 1; }

LIB="$HOME/src/frame-pacing-test/build/install/frame-pacing-test/lib"
[ -d "$LIB" ] || { echo "Harness not built -- run ./gradlew installDist first"; exit 1; }

M2="$HOME/.m2/repository/org/jetbrains/skiko"
SNAP="$M2/skiko-awt/0.0.0-SNAPSHOT/skiko-awt-0.0.0-SNAPSHOT.jar"
SNAP="$SNAP:$M2/skiko-awt-runtime-linux-x64/0.0.0-SNAPSHOT/skiko-awt-runtime-linux-x64-0.0.0-SNAPSHOT.jar"
for j in ${SNAP//:/ }; do
  [ -f "$j" ] || { echo "Missing $j -- publish skiko to mavenLocal first"; exit 1; }
done

# List every connected output rather than keeping the last one the loop saw:
# with two displays that named whichever connector sorted last, which is not
# necessarily the one the window is on, and a mislabelled row is worse than no
# row at all.
CONNECTED=""
for s in /sys/class/drm/card*-*/status; do
  [ -e "$s" ] || continue
  [ "$(cat "$s")" = connected ] && CONNECTED="$CONNECTED $(basename "$(dirname "$s")")"
done
CONNECTED="${CONNECTED# }"
[ -n "$CONNECTED" ] || { echo "NO DISPLAY ATTACHED -- pacing measurements need an active CRTC"; exit 1; }

# --- idle guard (see jbr-experiment for the rationale and the warm-up trap) --
# The ceiling cannot be a constant: it came from a 35 W i5 and a 16-thread Ryzen
# does not idle near it. Taken from JBR_IDLE_MAX, or the baseline written by
# `jbr-experiment --calibrate`, else the old Intel-shaped default.
BASELINE_FILE=/etc/jbr-idle-baseline
if [ -n "${JBR_IDLE_MAX:-}" ]; then
  IDLE_MAX="$JBR_IDLE_MAX"
elif [ -r "$BASELINE_FILE" ]; then
  IDLE_MAX=$(awk '{printf "%.2f", $1 * 1.6 + 0.5}' "$BASELINE_FILE")
else
  IDLE_MAX=2.0
fi

jbr-measure "warmup" 3 >/dev/null 2>&1
PRE=$(jbr-measure "preflight" 5)
IDLE_W=$(echo "$PRE" | grep -oE 'pkg=[[:space:]]*[0-9.]+' | grep -oE '[0-9.]+$')
# 0.00 W is not a quiet machine, it is a failed read: rd() falls back to 0 when
# the RAPL counters cannot be opened. Treating that as "idle" would wave through
# a run whose power columns are all zero, so refuse it explicitly.
if [ -z "${IDLE_W:-}" ] || awk -v w="${IDLE_W:-0}" 'BEGIN{exit !(w+0 <= 0)}'; then
  echo "ABORT: package power read back as ${IDLE_W:-empty} W -- the RAPL counters"
  echo "  are not readable by $(whoami). They are root-only by design; grant this"
  echo "  account /usr/local/bin/jbr-rapl in sudoers, or run jbr-measure to see"
  echo "  which columns come back zero."
  exit 1
fi
if awk -v w="${IDLE_W:-99}" -v m="$IDLE_MAX" 'BEGIN{exit !(w+0 > m+0)}'; then
  echo "ABORT: machine is not idle -- package power ${IDLE_W} W (ceiling ${IDLE_MAX} W)."
  echo "  if this machine is genuinely quiet, run: jbr-experiment --calibrate"
  ps -eo pcpu,pid,args --sort=-pcpu | head -6 | cut -c1-110 | sed 's/^/    /'
  exit 1
fi
echo "  idle check: ${IDLE_W} W package (ceiling ${IDLE_MAX} W) -- quiet, proceeding"

echo "=== Skiko frame pacing (skiko.swing.frame.pacing): unpaced vs paced ==="
echo "  host:    $(hostname)   window: $WIN${DISPLAY_IDX:+   screen: $DISPLAY_IDX}   toolkit: ${JBR_TOOLKIT:-XWayland}"
echo "  outputs: $CONNECTED  (window on ${DISPLAY_IDX:-primary})"
echo

run_mode() {   # $1 = false|true  $2 = label
  local log=/tmp/fp-skiko-$1.log
  "$JBR/bin/java" -cp "$SNAP:$LIB/*" \
    $TOOLKIT_OPT -Dskiko.swing.frame.pacing="$1" -Dwindow="$WIN" \
    ${DISPLAY_IDX:+-Ddisplay="$DISPLAY_IDX"} SkikoDirectMainKt > "$log" 2>&1 &
  local P=$!
  sleep 10
  if ! kill -0 "$P" 2>/dev/null; then
    echo "  $2: app exited early --"; head -8 "$log" | sed 's/^/      /'; return 1
  fi
  jbr-measure "$2 win=$WIN" "$SECS"
  awk -F': *' '/renders\/sec/{v[++n]=$2}
       END{s=0;c=0; for(i=4;i<=n;i++){s+=v[i];c++}
           if(c) printf "  %-30s renders/sec avg = %.1f  (n=%d)\n","",s/c,c}' "$log"
  kill "$P" 2>/dev/null; pkill -f SkikoDirectMainKt 2>/dev/null; sleep 2
  pkill -9 -f SkikoDirectMainKt 2>/dev/null; sleep 6
}

run_mode false "UNPACED"
echo
run_mode true  "PACED  "
echo
# --- post-run idle check (mid-run load makes figures junk; say so loudly) ----
POST=$(jbr-measure "postflight" 5)
POST_W=$(echo "$POST" | grep -oE 'pkg=[[:space:]]*[0-9.]+' | grep -oE '[0-9.]+$')
if awk -v w="${POST_W:-99}" -v m="$IDLE_MAX" 'BEGIN{exit !(w+0 > m+0)}'; then
  echo "  *** SUSPECT RUN: package power was ${POST_W} W after the run (ceiling ${IDLE_MAX} W)."
  echo "  *** Something loaded the machine mid-run; power figures above are unreliable."
  ps -eo pcpu,pid,args --sort=-pcpu | head -5 | cut -c1-110 | sed 's/^/      /'
else
  echo "  idle after run: ${POST_W} W -- clean, figures are trustworthy"
fi
echo
grep -E "needRender|frame\.pacing|java\.runtime" /tmp/fp-skiko-true.log | head -4 | sed 's/^/  /'
